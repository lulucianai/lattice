# Copy to .env and fill in. Required for the worker + deep-enrich.
# Helius RPC — MUST allow getProgramAccounts (public nodes don't). Free tier works.
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY
METEORA_DATAPI=https://dlmm.datapi.meteora.ag

# Optional worker tuning (defaults are in packages/ingest/src/worker.ts):
# INGEST_INTERVAL_MS=300000
# POOL_SWEEP=60
# POOL_PAGES=2
# DEEP_PER_PASS=3
# DEEP_HISTORY_PAGES=60
